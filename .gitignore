node_modules/
dist/
.astro/
.wrangler/
*.local
.env
.env.*
!.env.example

# Gas City
.gc/
.beads/*
!.beads/config.yaml
!.beads/metadata.json
hooks/
.runtime/

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key

# Nuxt build output (regenerated by `pnpm build`; do not commit)
.output/
.nuxt/

# Scraped live-page snapshots from ad-hoc `curl -o` verification. These are
# frozen copies that look like current evidence; record the measurement in a
# decision doc or an issue comment instead, and re-fetch before citing.
*.html

# STI-542: written by scripts/write-build-id.mjs on every build. Committing it
# would bake one build's commit into the repo and it would go stale the moment
# the next build ran, which is worse than not having it at all.
public/__build.json

# STI-542: build 1 kept aside by the determinism gate so the failing
# comparison can name the differing file. A build output, never a source.
.dist-build-1
.artifact-compare
